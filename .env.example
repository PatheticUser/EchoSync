# Authentication
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server Runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Audio Constants
SAMPLE_RATE=16000
FRAME_SIZE=512
CHANNELS=1
MAX_BUFFER_CHUNKS=50

# Model Parameters: STT (faster-whisper / CTranslate2)
WHISPER_MODEL_NAME=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2

# Model Parameters: VAD (Silero-VAD ONNX)
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=400

# Conversation Memory
LLM_MEMORY_TURNS=8

# Local Model Cache Paths
MODEL_CACHE_DIR=./models
VAD_MODEL_PATH=./models/vad/silero_vad.onnx
WHISPER_MODEL_DIR=./models/stt
KOKORO_MODEL_PATH=./models/tts/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=./models/tts/voices.bin
