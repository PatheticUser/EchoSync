# Authentication
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server Runtime
# Production: set APP_ENV=production (non-dev deployments reject WS Origin-less clients)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# WebSocket admission gate (production: replace default origins with your host)
# Comma-separated or JSON array. REQUIRED on Railway/Render public host.
WS_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","https://your-app.up.railway.app"]
WS_MAX_CONCURRENT=10
WS_MAX_PER_IP=3
# WS_BEARER_TOKEN=optional_shared_token

# Audio Constants
SAMPLE_RATE=16000
FRAME_SIZE=512
CHANNELS=1
MAX_BUFFER_CHUNKS=50

# Model Parameters: STT (faster-whisper / CTranslate2)
WHISPER_MODEL_NAME=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2

# Model Parameters: VAD (Silero-VAD ONNX)
VAD_THRESHOLD=0.35
VAD_SILENCE_MS=400

# Conversation Memory
LLM_MEMORY_TURNS=8

# Streaming Chunking (hyper-tune knobs)
# Lower LLM_CHUNK_MIN_CHARS for smaller, snappier TTS clauses; raise for longer, calmer ones.
# LLM_CHUNK_MIN_CHARS=20
# Set LLM_CHUNK_EARLY_FIRST=false to wait for sentence-terminal punctuation on the first clause too.
# LLM_CHUNK_EARLY_FIRST=true

# Local Model Cache Paths
MODEL_CACHE_DIR=./models
VAD_MODEL_PATH=./models/vad/silero_vad.onnx
WHISPER_MODEL_DIR=./models/stt
KOKORO_MODEL_PATH=./models/tts/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=./models/tts/voices.bin
