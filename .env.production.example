# EchoSync — production environment template (Oracle Cloud ARM64 + Caddy).
#
# Setup:  cp .env.production.example .env.production  &&  $EDITOR .env.production
# Then:   docker compose --env-file .env.production up -d --build
#
# The file is consumed twice:
#   1. docker-compose interpolation -> ${DOMAIN} feeds the Caddyfile
#   2. injected into the `app` container -> pydantic-settings (src/config.py)
# Every key below is optional unless marked REQUIRED; defaults live in src/config.py.

# =============================================================================
# Deployment / reverse proxy
# =============================================================================
# Public hostname (preferred) pointing at the VM's public IPv4/IPv6 via an A/AAAA
# record. Caddy obtains/renews Let's Encrypt TLS automatically for it.
# Use the bare IP (e.g. 203.0.113.10) or `localhost` for self-signed internal TLS.
DOMAIN=voice.example.com

# =============================================================================
# Authentication (REQUIRED — the app refuses to boot without the key)
# =============================================================================
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.6-flash

# =============================================================================
# Server runtime
# =============================================================================
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# WebSocket admission gate (/ws/audio)
# APP_ENV=production REJECTS connections whose Origin header is not listed here,
# so this MUST include the exact public origin Caddy serves (scheme + host, no
# trailing slash). Comma-separated or JSON array.
# =============================================================================
WS_ALLOWED_ORIGINS=["https://voice.example.com"]
WS_MAX_CONCURRENT=10
WS_MAX_PER_IP=3
# Optional shared secret; when set, clients must send `Authorization: Bearer <token>`
# on the WebSocket handshake. MUST stay commented out when unused — an empty
# value would be treated as a real (empty) token and reject all connections.
# WS_BEARER_TOKEN=change-me-long-random-string

# =============================================================================
# Audio constants
# =============================================================================
SAMPLE_RATE=16000
FRAME_SIZE=512
CHANNELS=1
MAX_BUFFER_CHUNKS=50

# =============================================================================
# STT — faster-whisper (CTranslate2)
# int8 is fully supported on aarch64 via oneDNN; keep models <= small.en on the
# Always Free 1-4 OCPU Ampere shapes. Set WHISPER_CPU_THREADS to your OCPU count.
# =============================================================================
WHISPER_MODEL_NAME=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
STT_BOOST_AUDIO=true
LLM_INJECT_TOOLS_CONTEXT=true

# =============================================================================
# VAD — Silero-VAD ONNX
# =============================================================================
VAD_THRESHOLD=0.35
VAD_SILENCE_MS=400
VAD_MIN_SPEECH_MS=250
VAD_PRE_PADDING_FRAMES=3
VAD_INTERRUPT_PROB=0.75

# =============================================================================
# LLM (Gemini)
# =============================================================================
LLM_MEMORY_TURNS=8
LLM_MAX_OUTPUT_TOKENS=350
LLM_TEMPERATURE=0.4
LLM_TOP_P=0.95
LLM_TIMEOUT_S=5.0
LLM_CHUNK_MIN_CHARS=20
LLM_CHUNK_EARLY_FIRST=true

# =============================================================================
# TTS engine
# kokoro = local ONNX synthesis, fully offline (weights pulled on first boot).
# edge   = Microsoft Edge neural TTS over the network (near-zero CPU; requires
#          outbound HTTPS from the VM).
# =============================================================================
TTS_ENGINE=kokoro
TTS_VOICE=af_sarah
TTS_SPEED=1.0
TTS_CHUNK_SIZE=2048
TTS_SAMPLE_RATE=24000
EDGE_VOICE=en-US-JennyNeural

# =============================================================================
# Model cache paths (in-container absolute paths; backed by the `models` Docker
# volume defined in docker-compose.yml — do not point these at the host.)
# =============================================================================
MODEL_CACHE_DIR=/app/models
VAD_MODEL_PATH=/app/models/vad/silero_vad.onnx
WHISPER_MODEL_DIR=/app/models/stt
KOKORO_MODEL_PATH=/app/models/tts/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=/app/models/tts/voices.bin

# =============================================================================
# Database
# =============================================================================
# EchoSync is fully stateless: conversation memory is in-process and model
# weights persist in the `models` Docker volume — no database is required or
# used anywhere in the codebase. Reserved for future use only, e.g.:
# DATABASE_URL=postgresql://echosync:change-me@db:5432/echosync
